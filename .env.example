# =============================================================================
# NotesBazaar by AbhyasMitra — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and configure your actual service credentials.
# NEVER commit real credentials, database passwords, or secret keys to Git.
# =============================================================================

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Firebase Client Configuration (Safe for browser / public)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Firebase Admin SDK (Server Only — DO NOT ADD NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Azure SQL Database (Server Only)
# -----------------------------------------------------------------------------
# You can provide AZURE_SQL_CONNECTION_STRING or the discrete credentials below:
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=notesbazaar
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_PORT=1433
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false
# Optional full connection string:
AZURE_SQL_CONNECTION_STRING=

# -----------------------------------------------------------------------------
# Azure Blob Storage (Server Only)
# -----------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NOTES=notes-private
AZURE_STORAGE_CONTAINER_PREVIEWS=notes-previews
AZURE_STORAGE_CONTAINER_ASSETS=site-assets

# -----------------------------------------------------------------------------
# Razorpay (Payments)
# -----------------------------------------------------------------------------
# Public Key ID is safe for browser:
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Secret Key and Webhook Secret MUST be server only:
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Admin Bootstrap & Access
# -----------------------------------------------------------------------------
ADMIN_EMAIL=vinaybhadane06@gmail.com

# -----------------------------------------------------------------------------
# Transactional Email Provider (Optional)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=support@abhyasmitra.com

# -----------------------------------------------------------------------------
# Analytics (Consent-Gated)
# -----------------------------------------------------------------------------
ANALYTICS_PROVIDER=google-analytics
ANALYTICS_ID=

